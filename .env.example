# ============================================================
# .env.example — FarmLink Intelligence
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — only commit this .env.example.
#
# To generate a SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ── Flask core ───────────────────────────────────────────────
SECRET_KEY=paste-your-generated-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=1

# ── Database ──────────────────────────────────────────────────
# Format: mysql+pymysql://USERNAME:PASSWORD@HOST/DATABASE_NAME
DATABASE_URL=mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost/farmlink

# ── Email (for password reset) ───────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=FarmLink Intelligence <noreply@farmlink.cm>
MAIL_SUPPRESS_SEND=true

# ── Admin account (used by seed.py) ──────────────────────────
ADMIN_EMAIL=admin@farmlink.cm
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=FarmLink Administrator